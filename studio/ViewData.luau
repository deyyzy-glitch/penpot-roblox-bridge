-- Generated UI layout data, not executable content. Source: studio/view-data.json.
local encoding=game:GetService('EncodingService')
local bytes=encoding:Base64Decode(buffer.fromstring(''))
local decoded=encoding:DecompressBuffer(bytes,Enum.CompressionAlgorithm.Zstd)
assert(buffer.len(decoded)==162920,'Invalid bundled UI data')
return game:GetService('HttpService'):JSONDecode(buffer.tostring(decoded))
