-- A fixed runtime template. Design strings are attributes, never interpolated source.
local Behaviors={}
function Behaviors.source()
 return [=[-- Generated by Penpot Bridge. Optional panel actions only.
local root=script.Parent
local source=root:GetAttribute('P2R_Design')
local panels={}
local function owned(i)
 if i:GetAttribute('P2R_Source')~=source then return false end
 local p=i
 while p and p~=root do
  if p:GetAttribute('P2R_Retired') or p:GetAttribute('P2R_Stale') then return false end
  if p~=i and p:GetAttribute('P2R_Design') and p:GetAttribute('P2R_Design')~=source then return false end
  p=p.Parent
 end
 return p==root
end
for _,i in root:GetDescendants() do
 if owned(i) and i:IsA('GuiObject') then
  local name=i:GetAttribute('P2R_Panel')
  if type(name)=='string' and name~='' then panels[name]=i end
 end
end
for _,i in root:GetDescendants() do
 if owned(i) and i:IsA('GuiButton') then
  local action=i:GetAttribute('P2R_Action')
  local target=i:GetAttribute('P2R_Target')
  if action=='open' or action=='close' then
   i.Activated:Connect(function()
    local panel=panels[target]
    if panel and panel.Parent then panel.Visible=action=='open' end
   end)
  end
 end
end
]=]
end
return Behaviors
